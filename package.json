{
  "name": "ricwiz",
  "displayName": "Ricwiz Branch Helper",
  "description": "Helps create branches for ticket development",
  "icon": "resources/logo.png",
  "version": "5.1.6",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "publisher": "vicente",
  "repository": {
    "type": "git",
    "url": "https://github.com/VicenteCruz/ricwiz.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ricwiz-sidebar",
          "title": "Ricwiz",
          "icon": "resources/ricwiz.svg"
        }
      ]
    },
    "views": {
      "ricwiz-sidebar": [
        {
          "type": "webview",
          "id": "ricwiz-webview",
          "name": "Operations"
        }
      ]
    },
    "commands": [
      {
        "command": "ricwiz.showJiraDetails",
        "title": "Ricwiz: Show Jira Details"
      },
      {
        "command": "ricwiz.changeJiraStatus",
        "title": "Ricwiz: Change Jira Status"
      },
      {
        "command": "ricwiz.addJiraComment",
        "title": "Ricwiz: Add Jira Comment"
      },
      {
        "command": "ricwiz.addJiraLabel",
        "title": "Ricwiz: Add Jira Label"
      },
      {
        "command": "ricwiz.setJiraToken",
        "title": "Ricwiz: Set Secure Jira API Token"
      },
      {
        "command": "ricwiz.setGitlabToken",
        "title": "Ricwiz: Set Secure GitLab API Token"
      },
      {
        "command": "ricwiz.generateDestructiveChanges",
        "title": "Ricwiz: Auto DestructiveChanges.xml"
      },
      {
        "command": "ricwiz.runSmartTests",
        "title": "Ricwiz: Run Smart Apex Tests"
      },
      {
        "command": "ricwiz.createBranches",
        "title": "Ricwiz: Create Ticket Branches"
      },
      {
        "command": "ricwiz.prepareDeploy",
        "title": "Ricwiz: Prepare Deploy (Merge to Environments)"
      },
      {
        "command": "ricwiz.createMergeRequests",
        "title": "Ricwiz: Open Merge Requests in Browser"
      },
      {
        "command": "ricwiz.createMergeRequestsVSCode",
        "title": "Ricwiz: Open Merge Requests in VS Code"
      },
      {
        "command": "ricwiz.openJiraTicket",
        "title": "Ricwiz: Open Jira Ticket in Browser"
      },
      {
        "command": "ricwiz.openJiraTicketVSCode",
        "title": "Ricwiz: Open Jira Ticket in VS Code"
      },
      {
        "command": "ricwiz.openSettings",
        "title": "Ricwiz: Open Settings"
      },
      {
        "command": "ricwiz.generatePackageXml",
        "title": "Ricwiz: Generate package.xml"
      },
      {
        "command": "ricwiz.deployPackage",
        "title": "Ricwiz: Deploy Package"
      },
      {
        "command": "ricwiz.importData",
        "title": "Ricwiz: Import Data"
      },
      {
        "command": "ricwiz.listTicketFiles",
        "title": "Ricwiz: List Ticket Files"
      },
      {
        "command": "ricwiz.resetTracking",
        "title": "Ricwiz: Reset Tracking"
      },
      {
        "command": "ricwiz.extractComponent",
        "title": "Ricwiz: Extract Component"
      },
      {
        "command": "ricwiz.deployMultiOrg",
        "title": "Ricwiz: Deploy to Multi-Org"
      },
      {
        "command": "ricwiz.captureAdminChanges",
        "title": "Ricwiz: Capture Admin Changes"
      },
      {
        "command": "ricwiz.openHistory",
        "title": "Ricwiz: Branch History"
      },
      {
        "command": "ricwiz.searchTicket",
        "title": "Ricwiz: Search Ticket Branches"
      },
      {
        "command": "ricwiz.copyBranchName",
        "title": "Ricwiz: Copy Branch Name"
      },
      {
        "command": "ricwiz.syncAll",
        "title": "Ricwiz: Sync All Ticket Branches"
      },
      {
        "command": "ricwiz.deleteUnusedBranches",
        "title": "Ricwiz: Delete Unused Branches"
      },
      {
        "command": "ricwiz.openJiraDashboard",
        "title": "Ricwiz: Open Jira Dashboard"
      },
      {
        "command": "ricwiz.updateBases",
        "title": "Ricwiz: Update Base Branches"
      },
      {
        "command": "ricwiz.whoToBlame",
        "title": "Ricwiz: Who to Blame"
      },
      {
        "command": "ricwiz.refreshWebview",
        "title": "Ricwiz: Refresh Webview"
      },
      {
        "command": "ricwiz.manualRefresh",
        "title": "Ricwiz: Manual Refresh (Sync state)"
      },
      {
        "command": "ricwiz.toggleAutoRefresh",
        "title": "Ricwiz: Toggle Auto Refresh"
      }
    ],
    "configuration": {
      "title": "Ricwiz Branch Helper",
      "properties": {
        "ricwiz.workflowStyle": {
          "order": 1,
          "type": "string",
          "enum": [
            "standard",
            "multi-remote"
          ],
          "default": "standard",
          "description": "Defines the branching strategy to use (Standard single-repo vs Multi-Remote)."
        },
        "ricwiz.upstreamRemote": {
          "order": 2,
          "type": "string",
          "default": "origin",
          "description": "The name of the remote to fetch base branches from (e.g., 'salesforce-master' or 'upstream'). Used only in multi-remote workflow. Tip: Run 'git remote -v' in your terminal to list your exact remote names."
        },
        "ricwiz.originRemote": {
          "order": 3,
          "type": "string",
          "default": "origin",
          "description": "The name of the remote to push your branches to (e.g., 'cdb' or 'origin'). Used only in multi-remote workflow. Tip: Run 'git remote -v' in your terminal to list your exact remote names."
        },
        "ricwiz.ticketSourceBranch": {
          "order": 4,
          "type": "string",
          "default": "main",
          "description": "The base branch from which the main ticket branches are created (e.g., main, develop, master)."
        },
        "ricwiz.workspaceCheckoutButtons": {
          "order": 5,
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "quality",
            "validation"
          ],
          "description": "Explicit list of branch names that will appear as quick checkout buttons in the Workspace panel. Leave empty to hide all buttons."
        },
        "ricwiz.defaultReviewers": {
          "order": 6,
          "type": "string",
          "default": "",
          "description": "Default reviewers for your Merge Requests (e.g., '@joao, @maria' or GitLab User IDs like '12345, 67890'). This will be pre-filled when preparing a deploy."
        },
        "ricwiz.environments": {
          "order": 7,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "sourceBranch": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "name": "Qual",
              "sourceBranch": "quality"
            },
            {
              "name": "Val",
              "sourceBranch": "validation"
            },
            {
              "name": "Prod",
              "sourceBranch": "main"
            }
          ],
          "description": "Environments to which deploy branches will be created, defining their source branches as well."
        },
        "ricwiz.jiraDashboards": {
          "order": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "jql": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "name": "My Open Tickets",
              "jql": "assignee = currentUser() AND resolution = Unresolved ORDER BY updated DESC"
            },
            {
              "name": "Reported by Me",
              "jql": "reporter = currentUser() ORDER BY created DESC"
            },
            {
              "name": "Recently Updated",
              "jql": "assignee = currentUser() ORDER BY updated DESC"
            }
          ],
          "description": "JQL Queries to fetch and display in the Ticket Dashboard."
        },
        "ricwiz.profiles": {
          "order": 9,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "workflowStyle": {
                "type": "string"
              },
              "upstreamRemote": {
                "type": "string"
              },
              "originRemote": {
                "type": "string"
              },
              "ticketSourceBranch": {
                "type": "string"
              },
              "ticketPrefix": {
                "type": "string"
              },
              "branchPrefix": {
                "type": "string",
                "description": "Optional prefix prepended to git branches (e.g., used by the CRC team format: 'CRC-R19-')"
              },
              "environments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "sourceBranch": {
                      "type": "string"
                    }
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "default": [],
          "description": "Define multiple workflow profiles to be prompted on branch creation (e.g. L4 vs Release)."
        },
        "ricwiz.ticketPrefix": {
          "order": 10,
          "type": "string",
          "default": "SFPSCA-",
          "description": "Prefix used for branch creation."
        },
        "ricwiz.branchPrefix": {
          "order": 11,
          "type": "string",
          "default": "",
          "description": "Optional prefix prepended to git branches (e.g., used by the CRC team format: 'CRC-R19-')."
        },
        "ricwiz.commitMessageSuffix": {
          "order": 12,
          "type": "string",
          "default": "- ",
          "description": "Suffix to append to the ticket ID in the auto-generated commit message (e.g., '- ' or ': ')."
        },
        "ricwiz.jiraUrl": {
          "order": 13,
          "type": "string",
          "default": "",
          "description": "Base URL for Jira tickets (e.g., https://jira.company.com/browse/). Leave empty to disable."
        },
        "ricwiz.jiraEmail": {
          "order": 14,
          "type": "string",
          "default": "",
          "description": "Your Jira Email address (required for fetching Jira ticket details via API)."
        },
        "ricwiz.gitlabUrlOverride": {
          "order": 15,
          "type": "string",
          "default": "",
          "description": "Base URL of the company's GitLab repository (e.g., https://gitlab.company.com/group/project). Leave empty for the extension to discover it automatically via git remote."
        },
        "ricwiz.packageXmlCommand": {
          "order": 20,
          "type": "string",
          "default": "sf sgd source delta --to \"HEAD\" --from \"{originRemote}/{baseBranch}\" --output-dir \".\"",
          "description": "The command used to generate the package.xml file. Use {originRemote} and {baseBranch} as placeholders for the multi-remote origin and ticket source branch."
        },
        "ricwiz.deployCommand": {
          "order": 21,
          "type": "string",
          "default": "sf project deploy start --manifest package/package.xml --post-destructive-changes destructiveChanges/destructiveChanges.xml -c -l NoTestRun -g",
          "description": "The command used to deploy the generated package.xml."
        },
        "ricwiz.importDataCommand": {
          "order": 22,
          "type": "string",
          "default": "sf data import tree --plan data/plan.json",
          "description": "The command used to import data."
        },
        "ricwiz.resetTrackingCommand": {
          "order": 23,
          "type": "string",
          "default": "sf org disable tracking && sf project reset tracking --no-prompt",
          "description": "The command used to reset source tracking."
        },
        "ricwiz.auditUsername": {
          "order": 30,
          "type": "string",
          "default": "admin@example.com",
          "description": "The Salesforce username to use when querying the SetupAuditTrail for changes."
        },
        "ricwiz.auditHours": {
          "order": 31,
          "type": "number",
          "default": 8,
          "description": "The default number of hours to look back when querying the SetupAuditTrail."
        },
        "ricwiz.autoRefresh": {
          "order": 40,
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh branch status when the repository state changes or the window regains focus. Disable to only refresh manually via the 🔄 button."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "pretest": "npm run compile && npm run lint",
    "lint": "npx tsc --noEmit",
    "test": "npx tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.1.3"
  }
}
